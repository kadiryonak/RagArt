# RagArt Configuration
# Copy this file to .env and fill in your key:  cp .env.example .env

# ============================================
# MODEL CONFIGURATION
# ============================================
# Options: 'groq', 'anthropic', 'deepseek', 'openai', 'huggingface', 'ollama', 'local'
# - groq:        Fast & free tier, good Turkish (requires GROQ_API_KEY)   <- recommended
# - anthropic:   Claude models, strong Turkish/reasoning (requires ANTHROPIC_API_KEY)
# - deepseek:    Strong Turkish (requires DEEPSEEK_API_KEY)
# - openai:      GPT models (requires OPENAI_API_KEY)
# - huggingface: HF Inference API (requires HUGGINGFACE_API_KEY)
# - ollama:      Local Ollama server (no key)
# - local:       Template fallback, no API needed (low quality)
MODEL_TYPE=groq

# ============================================
# API KEYS  (only the one matching MODEL_TYPE is required)
# ============================================
# Groq:        https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Anthropic:   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# DeepSeek:    https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OpenAI:      https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
# HuggingFace: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================
# PATHS
# ============================================
DATA_FOLDER=./data
CHROMA_DB_PATH=./chroma_db

# ============================================
# SERVER SETTINGS
# ============================================
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ============================================
# RAG CONFIGURATION (Optional)
# ============================================
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RELEVANCE_THRESHOLD=0.1
TOP_K_DOCUMENTS=5
